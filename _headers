# ==========================================================================
# PowerArcades Games — cabeçalhos de segurança
# --------------------------------------------------------------------------
# ATENÇÃO: este arquivo NÃO tem efeito no GitHub Pages, que não permite
# definir cabeçalhos de resposta. Ele fica pronto aqui para o dia em que o
# site for servido por um host que lê `_headers` (Cloudflare Pages, Netlify)
# ou for colocado atrás do Cloudflare com Transform Rules.
#
# Enquanto o host for o GitHub Pages, a proteção contra clickjacking vem do
# paliativo em assets/js/frame-guard.js. Ao migrar, aplique estes cabeçalhos
# e remova aquele script.
# ==========================================================================

/*
  # Impede que o site seja exibido dentro de um iframe de terceiros.
  # Só funciona como cabeçalho: via <meta> o navegador ignora.
  X-Frame-Options: DENY

  # Impede o navegador de "adivinhar" o tipo do conteúdo.
  X-Content-Type-Options: nosniff

  # Já enviado pelo GitHub, repetido aqui para o host novo.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Equivalente ao <meta name="referrer"> já presente nas páginas.
  Referrer-Policy: no-referrer

  # Desliga APIs que o site não usa.
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()

  # Isolamento entre origens. Além da segurança, COOP+COEP liberam
  # SharedArrayBuffer, o que permite ao EmulatorJS usar o núcleo
  # snes9x-thread-wasm (já incluído em data/cores/) e ganhar desempenho.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# --------------------------------------------------------------------------
# CSP como cabeçalho. Repete a política dos <meta> e acrescenta
# frame-ancestors, que é ignorada quando entregue via <meta>.
# --------------------------------------------------------------------------

/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'none'; connect-src 'self'; worker-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests

/games/*
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob: data:; connect-src 'self' blob:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests

# ROMs e núcleos: nunca devem ser lidos por outra origem.
/roms/*
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff

/data/*
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
